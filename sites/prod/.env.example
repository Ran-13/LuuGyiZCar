# ── LuuGyi Zcar — VPS production (isolated from TeleManager / Youtube) ──
# Port 8082 — do not use 8080 or 8081.
# ./scripts/setup-vps.sh fills secrets automatically when creating .env

COMPOSE_PROJECT_NAME=luugyi-prod
HOST_BIND=127.0.0.1
HOST_PORT=8082

DATA_DIR=./sites/prod/data
UPLOADS_DIR=./sites/prod/uploads

NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com

ADMIN_PATH=CHANGE_ME_ADMIN_SLUG
NEXT_PUBLIC_ADMIN_PATH=CHANGE_ME_ADMIN_SLUG

ADMIN_USERNAME=CHANGE_ME_USER
ADMIN_PASSWORD=CHANGE_ME_PASSWORD_MIN_16_CHARS
ADMIN_SECRET=CHANGE_ME_SECRET_MIN_16_CHARS

TRUST_PROXY_HEADERS=true
