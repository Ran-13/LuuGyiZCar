# Production example — host nginx proxies https://videos.example.com → 127.0.0.1:8082
#
#   docker compose --env-file sites/prod-a/.env -p luugyi-prod-a up -d --build

COMPOSE_PROJECT_NAME=luugyi-prod-a
HOST_BIND=127.0.0.1
HOST_PORT=8082

DATA_DIR=./sites/prod-a/data
UPLOADS_DIR=./sites/prod-a/uploads

NEXT_PUBLIC_SITE_URL=https://videos.example.com
ADMIN_PATH=replace-with-long-random-slug
NEXT_PUBLIC_ADMIN_PATH=replace-with-long-random-slug

ADMIN_USERNAME=replace-username
ADMIN_PASSWORD=replace-with-long-random-password-min-16
ADMIN_SECRET=replace-with-another-long-random-secret

TRUST_PROXY_HEADERS=true
