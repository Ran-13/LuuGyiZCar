# ── akogyivip.site ───────────────────────────────────────────────
# VPS port 8082 (8080=TeleManager, 8081=Youtube — do not reuse)

COMPOSE_PROJECT_NAME=luugyi-akogyivip
HOST_BIND=127.0.0.1
HOST_PORT=8082

DATA_DIR=./sites/akogyivip/data
UPLOADS_DIR=./sites/akogyivip/uploads

NEXT_PUBLIC_SITE_URL=https://akogyivip.site
ADMIN_PATH=CHANGE_ME_ON_SERVER
NEXT_PUBLIC_ADMIN_PATH=CHANGE_ME_ON_SERVER

ADMIN_USERNAME=CHANGE_ME_ON_SERVER
ADMIN_PASSWORD=CHANGE_ME_ON_SERVER_MIN_16
ADMIN_SECRET=CHANGE_ME_ON_SERVER_MIN_16

TRUST_PROXY_HEADERS=true
