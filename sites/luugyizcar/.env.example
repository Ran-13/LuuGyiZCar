# ── luugyizcar.site ──────────────────────────────────────────────
# VPS port 8083 (8080=TeleManager, 8081=Youtube, 8082=akogyivip)

COMPOSE_PROJECT_NAME=luugyi-luugyizcar
HOST_BIND=127.0.0.1
HOST_PORT=8083

DATA_DIR=./sites/luugyizcar/data
UPLOADS_DIR=./sites/luugyizcar/uploads

NEXT_PUBLIC_SITE_URL=https://luugyizcar.site
ADMIN_PATH=CHANGE_ME_ON_SERVER
NEXT_PUBLIC_ADMIN_PATH=CHANGE_ME_ON_SERVER

ADMIN_USERNAME=CHANGE_ME_ON_SERVER
ADMIN_PASSWORD=CHANGE_ME_ON_SERVER_MIN_16
ADMIN_SECRET=CHANGE_ME_ON_SERVER_MIN_16

TRUST_PROXY_HEADERS=true
