# Default single-site local/prod template.
# Prefer sites/site1/.env + ./scripts/up-site.sh for multi-domain setups.

COMPOSE_PROJECT_NAME=luugyi-web
HOST_BIND=0.0.0.0
HOST_PORT=3000
DATA_DIR=./data
UPLOADS_DIR=./public/uploads

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hidden admin URL: http://localhost:3000/<slug>
ADMIN_PATH=hFWuUG0inBpk
NEXT_PUBLIC_ADMIN_PATH=hFWuUG0inBpk

ADMIN_USERNAME=your-unique-username
ADMIN_PASSWORD=replace-with-long-random-password-min-16-chars
ADMIN_SECRET=replace-with-another-long-random-secret

# Optional: Adsterra Publisher API token (Admin → Adsterra stats)
# ADSTERRA_API_KEY=

TRUST_PROXY_HEADERS=false
